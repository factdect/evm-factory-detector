# Which chains to run. Chain = config: same code for every EVM chain.
CHAINS=4663
# CHAINS=4663,8453

PORT=8080
# SQLite file. On Railway: mount a volume at /data and use /data/factory.db
DB_PATH=./data/factory.db
# all = indexer + API in one process (recommended: they share one RPC rate budget)
ROLE=all

# ---- per-chain overrides (suffix = chain id) --------------------------------------
# RPC_4663=https://rpc.mainnet.chain.robinhood.com
# RPC_HEADERS_4663={"authorization":"Bearer ..."}
# MIN_INTERVAL_MS_4663=450      # spacing between HTTP requests (public RH RPC: 429 after ~5 req / 2 s)
# LOGS_CHUNK_4663=2000          # block span per eth_getLogs
# POLL_MS_4663=3000             # live loop poll interval. Each poll costs ~3-4 calls; raise it to cut a metered RPC's bill (Base default 4000)
# STATE_WINDOW_4663=2500        # how far back the node serves historical state. 0 = unlimited (archive RPC)
# START_BLOCK_4663=             # first start only. Default: head - 6000
# STATS_WINDOW_BLOCKS_4663=     # window for "tokens announced" / template purity. Default: 3 days
# MAX_LAG_BLOCKS_4663=          # further behind than this, live indexing jumps ahead and the gap is replayed. Default: 30 min of blocks. 0 = never jump
# BIRTH_SCAN_WINDOWS_4663=24     # a lookup of a protocol token the index does not hold yet (born before the index, or in a gap) searches its birth this many ADDR_LOGS_SPAN windows back. 0 = off. Default 24 (Base on its public RPC: 0)
# RPC_8453=                     # REQUIRED for Base: mainnet.base.org caps getLogs at 200 blocks and rate-limits servers (HTTP 429) since 2026-10-08
#   with Alchemy (paid plan, measured 2026-10-27: 10,000-block topic getLogs, 100,000-block address getLogs, batches of 12):
#   RPC_8453=https://base-mainnet.g.alchemy.com/v2/<key>  LOGS_CHUNK_8453=2000  ADDR_LOGS_SPAN_8453=100000  POLL_MS_8453=6000

# ---- storage ----------------------------------------------------------------------
# BACKFILL=on                   # replay blocks skipped by a long stall (known launchpad events only). off = skip
# MIN_FREE_MB=150               # below this much free space, the oldest birth evidence is pruned (tokens never are)
# RETAIN_REFS_DAYS=0            # >0: also prune birth evidence older than N days on a schedule. 0 = keep all

# ---- optional: trace tokens born before the index started --------------------------
# Either key works; with both set, Etherscan is tried first. One key covers all chains via ?chainid=.
# Free keys: https://etherscan.io/apis  |  https://dev.blockscout.com
# ETHERSCAN_API_KEY=
# BLOCKSCOUT_API_KEY=

# ---- public API protection ----------------------------------------------------------
LOOKUPS_PER_MINUTE=30           # per client, only for tokens outside the index (those cost RPC calls)
TRUST_PROXY_HOPS=1              # Railway edge = 1. Behind Cloudflare + Railway = 2. Direct = 0
