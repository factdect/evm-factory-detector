# Which chains to run. Chain = config: same code for every EVM chain.
CHAINS=4663
# CHAINS=4663,8453

PORT=8080
# SQLite file. On Railway: mount a volume at /data and use /data/factory.db
DB_PATH=./data/factory.db
# all = indexer + API in one process (recommended: they share one RPC rate budget)
ROLE=all

# ---- per-chain overrides (suffix = chain id) --------------------------------------
# RPC_4663=https://rpc.mainnet.chain.robinhood.com
# RPC_HEADERS_4663={"authorization":"Bearer ..."}
# MIN_INTERVAL_MS_4663=450      # spacing between HTTP requests (public RH RPC: 429 after ~5 req / 2 s)
# LOGS_CHUNK_4663=2000          # block span per eth_getLogs
# STATE_WINDOW_4663=2500        # how far back the node serves historical state. 0 = unlimited (archive RPC)
# START_BLOCK_4663=             # first start only. Default: head - 6000
# STATS_WINDOW_BLOCKS_4663=     # window for "tokens announced" / template purity. Default: 3 days

# ---- optional: trace tokens born before the index started --------------------------
# Either key works; with both set, Etherscan is tried first. One key covers all chains via ?chainid=.
# Free keys: https://etherscan.io/apis  |  https://dev.blockscout.com
# ETHERSCAN_API_KEY=
# BLOCKSCOUT_API_KEY=

# ---- public API protection ----------------------------------------------------------
LOOKUPS_PER_MINUTE=30           # per client, only for tokens outside the index (those cost RPC calls)
TRUST_PROXY_HOPS=1              # Railway edge = 1. Behind Cloudflare + Railway = 2. Direct = 0
